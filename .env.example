# Servicio de imágenes a usar: 'stable-diffusion', 'gemini', 'dalle'
IMAGE_SERVICE=stable-diffusion

# API Keys (elige una según el servicio que uses):

# Hugging Face (GRATIS) - Para Stable Diffusion
# Obtén tu token en: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxx

# OpenAI (DE PAGO) - Para DALL-E 3
# Obtén tu key en: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# Google Gemini (NO GENERA IMÁGENES)
# GEMINI_API_KEY=obtén_tu_clave_en_https://aistudio.google.com/apikey

PORT=3000
NODE_ENV=development
MAX_GENERATIONS_PER_SESSION=10
